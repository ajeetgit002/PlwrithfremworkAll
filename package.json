{
  "name": "auto_suit",
  "version": "1.0.0",
  "description": "Senior SDET Playwright automation framework with AI capabilities",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node scripts/runner.js",
    "menu": "node scripts/runner.js",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:ai": "playwright test src/tests/ai",
    "test:auth": "playwright test src/tests/auth",
    "test:admin": "playwright test src/tests/admin",
    "test:dashboard": "playwright test src/tests/dashboard",
    "test:pim": "playwright test src/tests/pim",
    "test:a11y": "playwright test src/tests/accessibility",
    "test:perf": "playwright test src/tests/performance",
    "test:network": "playwright test src/tests/network",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "lint": "tsc --noEmit",
    "report": "playwright show-report",
    "codegen": "playwright codegen"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "sdet",
    "ai",
    "agentic",
    "self-healing",
    "accessibility",
    "performance"
  ],
  "author": "Ajeet Yadav",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@faker-js/faker": "^10.3.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2"
  }
}
