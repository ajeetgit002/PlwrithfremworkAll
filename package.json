{
  "name": "auto_suit",
  "version": "1.0.0",
  "description": "Senior SDET Playwright automation framework",
  "private": true,
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:auth": "playwright test src/tests/auth",
    "test:admin": "playwright test src/tests/admin",
    "test:dashboard": "playwright test src/tests/dashboard",
    "test:pim": "playwright test src/tests/pim",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "lint": "tsc --noEmit",
    "report": "playwright show-report",
    "codegen": "playwright codegen"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "sdet"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
